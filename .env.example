# Pet Health Cost Explorer Configuration
# Copy this file to .env and adjust as needed

# =============================================================================
# DATA SOURCES
# =============================================================================

# Use synthetic cost model (true) or real claims data (false)
# When true, costs are estimated using Monte Carlo simulation
# When false, requires configured claims data source
USE_SYNTHETIC_COSTS=true

# Default country/region for cost estimates
# Supported: UK, US, DE, SE (more can be added)
DEFAULT_COUNTRY=UK

# Currency for cost display
# Supported: GBP, USD, EUR, SEK
DEFAULT_CURRENCY=GBP

# =============================================================================
# DATABASE
# =============================================================================

# Path to SQLite database (relative to project root)
DATABASE_PATH=data/pet_insights.db

# =============================================================================
# SIMULATION SETTINGS
# =============================================================================

# Random seed for reproducible Monte Carlo simulations
SIMULATION_SEED=42

# Number of Monte Carlo iterations for cost estimation
SIMULATION_ITERATIONS=10000

# =============================================================================
# COST MODEL PARAMETERS
# =============================================================================

# Annual cost inflation rate (decimal)
COST_INFLATION_RATE=0.05

# Base year for cost data (costs are inflated from this year)
COST_BASE_YEAR=2024

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (relative to project root)
LOG_FILE=logs/petcost.log

# =============================================================================
# EXTERNAL DATA SOURCES (Optional - for future integration)
# =============================================================================

# VetCompass API (if available)
# VETCOMPASS_API_KEY=your_api_key_here
# VETCOMPASS_API_URL=https://api.vetcompass.org/v1

# Insurance claims data source
# CLAIMS_DATA_SOURCE=none
# CLAIMS_API_KEY=your_api_key_here
# CLAIMS_API_URL=https://api.insurer.example.com/v1

# =============================================================================
# DASHBOARD SETTINGS
# =============================================================================

# Streamlit server port
STREAMLIT_PORT=8501

# Enable debug mode in dashboard
DASHBOARD_DEBUG=false
